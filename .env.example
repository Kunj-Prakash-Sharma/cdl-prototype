# Copy to .env for local dev. All values here are fake and safe to commit.
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgres://self:self@localhost:5433/self

# Chat inactivity (minutes) before a session counts as lost
CHAT_INACTIVITY_MINUTES=30

# Integration adapters: "fake" in dev/test. Real vendor names are added as adapters land.
SMS_PROVIDER=fake
PAYMENTS_PROVIDER=fake
VIDEO_PROVIDER=fake
STORAGE_PROVIDER=fake
AI_PROVIDER=fake
EMAIL_PROVIDER=fake
ANALYTICS_PROVIDER=fake
# Jobs run on Postgres (pg-boss). Use "fake" in unit tests only.
QUEUE_PROVIDER=pgboss
