# Copy to .env for local dev. All values here are fake and safe to commit.
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgres://self:self@localhost:5433/self
# Separate database for automated tests (vitest integration, Playwright). Must end in _test: the test setup
# refuses anything else, so a test can never wipe your dev data. Created automatically by `npm run test:int`.
TEST_DATABASE_URL=postgres://self:self@localhost:5433/self_test

# Chat inactivity (minutes) before a session counts as lost
CHAT_INACTIVITY_MINUTES=30

# Integration adapters: "fake" in dev/test. Real vendor names are added as adapters land.
SMS_PROVIDER=fake
PAYMENTS_PROVIDER=fake
VIDEO_PROVIDER=fake
STORAGE_PROVIDER=fake
AI_PROVIDER=fake
EMAIL_PROVIDER=fake
ANALYTICS_PROVIDER=fake
# Jobs run on Postgres (pg-boss). Use "fake" in unit tests only.
QUEUE_PROVIDER=pgboss

# Auth. Dev only: the Turnstile keys are Cloudflare's public test keys (invisible widget, always passes).
# AUTH_SECRET: generate your own with `openssl rand -base64 32`. Real values per environment in production.
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
TURNSTILE_SITE_KEY=1x00000000000000000000BB
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Comma-separated +91 numbers that become admins at login (leave empty for none)
ADMIN_PHONES=
